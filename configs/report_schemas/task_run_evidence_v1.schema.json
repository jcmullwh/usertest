{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Run Report with Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "goal",
    "summary",
    "representative_workflow",
    "steps",
    "outputs",
    "verification",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "task_run_v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failure"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "representative_workflow": {
      "$ref": "#/$defs/representative_workflow"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification_check"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "user_experience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "friction_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unclear_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "what_would_help_next_time": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "outputs": {
            "minItems": 1
          },
          "verification": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "representative_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_point",
        "workflow",
        "why_representative",
        "user_visible_result"
      ],
      "properties": {
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "why_representative": {
          "type": "string",
          "minLength": 1
        },
        "user_visible_result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "attempts",
        "outcome"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "result",
        "evidence"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "generated_this_run",
            "updated_this_run",
            "terminal_output",
            "other"
          ]
        }
      }
    },
    "verification_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "result",
        "evidence"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "details"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string"
        },
        "suggested_fix": {
          "type": "string"
        }
      }
    }
  }
}
